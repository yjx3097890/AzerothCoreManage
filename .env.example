# AzerothCore Manage — 环境变量（复制为 .env 后按环境修改）
#   cp .env.example .env
#
# Docker Compose 会自动读取本文件做 ${VAR} 替换；
# API 读取 api/config.yaml 时也会加载 .env，并展开其中的 ${VAR}。

# —— 游戏服目录 / 网络（与 compose volume、config conf.* 共用）——
# API 容器挂载整个 AC_ROOT（conf / modules / docker/vol/etc / compose override / git）
AC_ROOT=/home/yjx/wow/azerothcore-wotlk
AC_NETWORK=azerothcore-wotlk_ac-network

# —— 面板对外端口（仅 web；API 由 nginx 内网反代，不映射宿主机）——
ACMANAGE_WEB_PORT=8086

# —— 面板账号 ——
PANEL_JWT_SECRET=change-me-before-deploy
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=admin

# —— 目标服 ——
TARGET_ID=lan
TARGET_NAME=局域网游戏服
DOCKER_ENABLED=false

# SOAP / MySQL：同机 Docker 网络内可写容器名；跨机写 IP
SOAP_HOST=192.168.31.100
SOAP_PORT=7878
SOAP_USERNAME=admin
SOAP_PASSWORD=admin

MYSQL_HOST=192.168.31.100
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=admin
MYSQL_AUTH_DB=acore_auth
MYSQL_CHARACTERS_DB=acore_characters
MYSQL_WORLD_DB=acore_world
MYSQL_PLAYERBOTS_DB=acore_playerbots

BOT_ACCOUNT_PREFIX=rndbot

# —— 模块管理 ——
MODULES_DEPLOY=docker
# 检查点目录落在仓库 ./data/module-checkpoints（compose 挂载 ./data:/data）
# 本地 make api 做备份/检查点需本机有 mysqldump：brew install mysql-client
# Docker 部署的 API 镜像已含 mariadb-client（需重建镜像后生效）
# 本机核心版本保底（SOAP server info / AC_ROOT git 都失败时才用）
# 示例：AC_CORE_VERSION=AzerothCore rev. 9adba48+   或只填短哈希
AC_CORE_VERSION=AzerothCore rev. 413bea61a85e+ 2026-09-04 09:03:49 -0700 (Playerbot branch) (Unix, RelWithDebInfo, Static)
AC_CORE_REVISION=413bea61a85e
DEEPSEEK_API_KEY=
# OpenAI 兼容 Chat Completions 根地址（请求会打到 {BASE}/chat/completions）
# 默认 DeepSeek；也可换成 https://api.openai.com/v1 或其他兼容网关
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
GITHUB_TOKEN=
